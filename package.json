{
  "name": "react-harness",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "ast-ui",
    "renderer",
    "mcp-server"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write \"**/*.{css,dita*,json,md,xml,xsl,yml,ts,tsx,js,mjs,mts}\"",
    "prettier-check": "prettier --check \"**/*.{css,dita*,json,md,xml,xsl,yml,ts,tsx,js,mjs,mts}\""
  },
  "devDependencies": {
    "@prettier/plugin-xml": "3.4.2",
    "lefthook": "^2.1.15",
    "prettier": "3.9.6"
  }
}
