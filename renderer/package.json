{
  "name": "ast-renderer",
  "version": "1.0.0",
  "description": "Next.js web portal rendering DITA Abstract Syntax Tree topics into React Bootstrap components",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:cluster": "node server.js",
    "format": "prettier --ignore-path ../.gitignore --write .",
    "format:check": "prettier --ignore-path ../.gitignore --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dita-bootstrap/ast-ui": "*",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
