{
  "name": "ast-data-store",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Express API serving DITA AST JSON topic files and MiniSearch search indices",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "format": "prettier --ignore-path ../.gitignore --write .",
    "format:check": "prettier --ignore-path ../.gitignore --check .",
    "prettier": "prettier --ignore-path ../.gitignore --write ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
