# Chat-bot LLM providers — placeholders; fill in only the keys you use.
# A provider is enabled when its API key (or, for Ollama, its base URL) is set.
CHAT_BOT_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Add your Open AI key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Ollama can be run as an additional docker container, but it is memory intensive
# docker-compose/ollama.yml overrides this to http://ollama:11434/v1 (in-network instance).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VERSION=0.5.7

# Add your Gemini key
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=models/gemini-3.6-flash

# MCP Server URL for mcp-client
MCP_SERVER_URL=http://mcp-server:4001/mcp

# Set to true only if debug badges for search_documentation/get_topic_content are desired
SHOW_TOOL_INVOCATIONS=false
