# private project instructions, not checked in - matches the toolkit root's
# CLAUDE.local.md convention
CLAUDE.local.md

# dependencies
node_modules/
**/node_modules/
/renderer/node_modules
/renderer/.pnp
/renderer/.pnp.js
/renderer/.yarn/install-state.gz
/data-store/node_modules
/mcp-server/node_modules
/mcp-client/node_modules

# build output / dist directories
dist/
**/dist/
/data-store/dist
/mcp-server/dist
/mcp-client/dist

# renderer: next.js / build output
/renderer/coverage
/renderer/.next/
/renderer/out/
/renderer/build
/renderer/.vercel

# data-store: synced ast-bootstrap transform output - regenerated via rsync, not
# hand-edited (see README.md "Prerequisites"); .gitkeep placeholders keep the
# directory structure present on a fresh clone, before the first sync
/data-store/data/*
!/data-store/data/.gitkeep
!/data-store/data/src/
/data-store/data/src/*
!/data-store/data/src/.gitkeep
**/search-index.json

# renderer: regenerated by `next dev`, not authored content - see AGENTS.md's own note
/renderer/AGENTS.md
/renderer/CLAUDE.md

# env files
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local dev tooling artifacts (browse skill logs, not project content)
.gstack/

# personal Claude Code permission overrides, not shared with the team
/.claude/settings.local.json
