# private project instructions, not checked in - matches the toolkit root's
# CLAUDE.local.md convention
CLAUDE.local.md

# dependencies
node_modules/
**/node_modules/
/frontend/node_modules
/frontend/.pnp
/frontend/.pnp.js
/frontend/.yarn/install-state.gz
/backend/node_modules
/mcp-server/node_modules
/mcp-client/node_modules

# build output / dist directories
dist/
**/dist/
/backend/dist
/mcp-server/dist
/mcp-client/dist

# frontend: next.js / build output
/frontend/coverage
/frontend/.next/
/frontend/out/
/frontend/build
/frontend/.vercel

# backend: synced ast-bootstrap transform output - regenerated via rsync, not
# hand-edited (see README.md "Prerequisites"); .gitkeep placeholders keep the
# directory structure present on a fresh clone, before the first sync
/backend/data/*
!/backend/data/.gitkeep
!/backend/data/src/
/backend/data/src/*
!/backend/data/src/.gitkeep
**/search-index.json

# frontend: regenerated by `next dev`, not authored content - see AGENTS.md's own note
/frontend/AGENTS.md
/frontend/CLAUDE.md

# env files (local overrides ignored)
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local dev tooling artifacts (browse skill logs, not project content)
.gstack/

# personal Claude Code permission overrides, not shared with the team
/.claude/settings.local.json
