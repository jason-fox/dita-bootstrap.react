              "code",
              "<p>\n  <button props=\"collapse-toggle\" href=\"#collapse2\">Toggle Width Collapse</button>\n</p>\n<collapse outputclass=\"collapse-horizontal\" id=\"collapse2\" otherprops=\"style(min-height: 120px;)\">\n  <bodydiv outputclass=\"card card-body\" otherprops=\"style(width: 300px;)\">\n    <p>This is some placeholder content for a horizontal collapse. It’s hidden by default and shown when triggered.</p>\n  </bodydiv>\n</collapse>"
            ]
