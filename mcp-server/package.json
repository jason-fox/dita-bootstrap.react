{
  "name": "ast-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Abstract Syntax Tree DITA documentation with MCP-UI React rendering",
  "main": "dist/index.js",
  "bin": {
    "dita-docs-mcp": "dist/index.js"
  },
  "scripts": {
    "build:client": "node scripts/build-client-bundle.mjs",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "npm run build:client && tsc --noEmit",
    "test": "npm run build:client && vitest run",
    "build": "npm run typecheck && npm run build:server",
    "dev": "npm run build:client && tsx watch src/server/index.ts --data-dir ../data-store/data",
    "start": "node dist/index.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "minisearch": "^7.1.1",
    "prismjs": "^1.29.0",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.9",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dita-bootstrap/ast-ui": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
