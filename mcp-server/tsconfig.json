{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../renderer/*"],
      "@modelcontextprotocol/ext-apps/server": ["./node_modules/@modelcontextprotocol/ext-apps/dist/src/server/index.d.ts"],
      "@modelcontextprotocol/ext-apps/react": ["./node_modules/@modelcontextprotocol/ext-apps/dist/src/react/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
